generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String?
  role          Role           @default(CUSTOMER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  name          String?
  phone         String?        @unique
  businessName  String?
  googleId      String?        @unique
  addresses     Address[]
  cart          Cart?
  customerFlags CustomerFlag[]
  events        Event[]
  orders        Order[]
  payments      Payment[]
  adminProducts   Product[]      @relation("AdminCreatedProducts")
  seller          Seller?
  couponUsages    CouponUsage[]
  pointsLedger    EkoraPointsLedger[]
  adminOrderNotes OrderAdminNote[] @relation("AdminOrderNoteAuthor")
  leads           Lead[]
  reviews         Review[]       @relation("CustomerReviews")
  moderatedReviews Review[]      @relation("AdminModeratedReviews")
}

model Seller {
  id                  String                  @id
  userId              String                  @unique
  brandName           String
  accountStatus       SellerAccountStatus     @default(DISABLED)
  applicationStatus   SellerApplicationStatus @default(DRAFT)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  rejectionReason     String?
  payments            Payment[]
  priceChangeRequests PriceChangeRequest[]
  products            Product[]               @relation("SellerProducts")
  user                User                    @relation(fields: [userId], references: [id])
  businessDetails     SellerBusiness?
}

model SellerBusiness {
  id                     String    @id @default(uuid())
  sellerId               String    @unique
  legalName              String
  businessType           String
  address                String
  gstin                  String?
  gstStatus              GSTStatus @default(NOT_SUBMITTED)
  documentUrls           Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  addressType            String?
  city                   String?
  constitutionOfBusiness String?
  country                String?   @default("India")
  district               String?
  gstRegistrationDate    String?
  natureOfBusiness       Json?
  pincode                String?
  state                  String?
  taxpayerType           String?
  tradeName              String?
  seller                 Seller    @relation(fields: [sellerId], references: [id])
}

model Product {
  id                       String                   @id @default(uuid())
  title                    String
  description              String?
  price                    Int
  stock                    Int                      @default(0)
  status                   ProductStatus            @default(DRAFT)
  rejectionReason          String?
  imageUrl                 String?
  images                   String[]                 @default([])
  sellerId                 String?
  createdByAdminId         String?
  source                   String                   @default("SELLER")
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  customerPrice            Int?
  mrp                      Int?
  isActive                 Boolean                  @default(true)
  adminManaged             Boolean                  @default(false)
  categoryId               String?
  categoryRef              Category?                @relation(fields: [categoryId], references: [id])
  category                 String?                  @default("General Silicone Moulds")
  classificationConfidence ClassificationConfidence @default(UNCLASSIFIED)
  classificationStatus     ClassificationStatus     @default(NEEDS_REVIEW)
  moq                      Int                      @default(1)
  wholesaleTiers           Json?
  breadthCm                Float?
  heightCm                 Float?
  lengthCm                 Float?
  weightKg                 Float?
  version                  Int                      @default(1)
  lockedFields             String[]                 @default([])
  supplierAvailable        Boolean?
  lastSyncedAt             DateTime?
  excludedFromTiers        Boolean                  @default(false)
  cartItems                CartItem[]
  priceChangeRequests      PriceChangeRequest[]
  adminCreator             User?                    @relation("AdminCreatedProducts", fields: [createdByAdminId], references: [id])
  seller                   Seller?                  @relation("SellerProducts", fields: [sellerId], references: [id])
  supplierProducts         SupplierProduct[]
  reviews                  Review[]
  reviewTokens             ReviewToken[]

  @@index([status, categoryId])
  @@index([status, category])
  @@index([status, sellerId])
}

model PriceChangeRequest {
  id             String                   @id @default(uuid())
  productId      String
  sellerId       String
  oldPrice       Int
  requestedPrice Int
  reason         String?
  status         PriceChangeRequestStatus @default(PENDING)
  adminComment   String?
  createdAt      DateTime                 @default(now())
  reviewedAt     DateTime?
  reviewedBy     String?
  product        Product                  @relation(fields: [productId], references: [id])
  seller         Seller                   @relation(fields: [sellerId], references: [id])
}

model Order {
  id                String               @id @default(uuid())
  customerId        String
  status            OrderStatus          @default(PAYMENT_PENDING)
  paymentStatus     PaymentStatus        @default(PENDING)
  subtotal          Int
  discount          Int                  @default(0)
  tax               Int                  @default(0)
  shipping          Int                  @default(0)
  total             Int
  currency          String               @default("INR")
  razorpayOrderId   String?              @unique
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  addressId         String?
  addressSnapshot   Json?
  awbCode           String?
  courierName       String?
  deliveredAt       DateTime?
  shipmentId        String?
  shippedAt         DateTime?
  shippingStatus    ShippingStatus       @default(NOT_CREATED)
  shiprocketOrderId String?
  trackingUrl       String?
  dispatchedAt      DateTime?
  cancellationReason String?
  source            String?              @default("website")
  isSynthetic       Boolean              @default(false)
  couponCode        String?
  couponId          String?
  eligibleSubtotal  Decimal?             @db.Decimal(12, 2)
  tierId            Int?
  tierDiscount      Decimal?             @default(0) @db.Decimal(12, 2)
  pointsRedeemed    Int?                 @default(0)
  pointsDiscount    Decimal?             @default(0) @db.Decimal(12, 2)
  experimentVariant String?
  pricingSnapshot   Json?
  address           Address?             @relation(fields: [addressId], references: [id])
  customer          User                 @relation(fields: [customerId], references: [id])
  coupon            Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponUsage       CouponUsage?
  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  payments          Payment[]
  giftClaims        GiftClaim[]
  orderAdjustments  OrderAdjustment[]
  pointsLedger      EkoraPointsLedger[]
  shipments         OrderShipment[]
  adminNotes        OrderAdminNote[]
  sourceLead        Lead?                @relation("LeadSourceOrder")
  convertedLeads    Lead[]               @relation("LeadConvertedOrder")
  reviews           Review[]
  reviewTokens      ReviewToken[]
}

model OrderShipment {
  id             String         @id @default(uuid())
  orderId        String
  shipmentNumber Int            @default(1)
  courierName    String
  awbCode        String
  trackingUrl    String?
  status         ShippingStatus @default(SHIPPED)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([awbCode])
}

model OrderAdminNote {
  id        String   @id @default(uuid())
  orderId   String
  authorId  String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author    User?    @relation("AdminOrderNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt(sort: Desc)])
}

model Lead {
  id               String     @id @default(uuid())
  dedupeKey        String     @unique
  source           LeadSource
  status           LeadStatus @default(NEW)
  customerId       String?
  orderId          String?    @unique
  convertedOrderId String?
  customerName     String?
  customerEmail    String?
  customerPhone    String?
  itemsSnapshot    Json?
  orderValue       Int        @default(0)
  currency         String     @default("INR")
  reason           String?
  lastActivityAt   DateTime   @default(now())
  convertedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  customer         User?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order            Order?     @relation("LeadSourceOrder", fields: [orderId], references: [id], onDelete: SetNull)
  convertedOrder   Order?     @relation("LeadConvertedOrder", fields: [convertedOrderId], references: [id], onDelete: SetNull)

  @@index([source, status])
  @@index([customerId])
  @@index([customerEmail])
  @@index([lastActivityAt(sort: Desc)])
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  notes     String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id                  String   @id @default(uuid())
  orderId             String
  productId           String
  sellerId            String?
  productNameSnapshot String
  priceSnapshot       Int
  quantity            Int
  subtotal            Int
  isGift              Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  order               Order    @relation(fields: [orderId], references: [id])
  review              Review?
  reviewToken         ReviewToken?
}

model Payment {
  id                String        @id @default(uuid())
  userId            String
  sellerId          String?
  orderId           String?
  type              PaymentType
  provider          String        @default("RAZORPAY")
  amount            Int
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  webhookEventId    String?       @unique
  failureReason     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order?        @relation(fields: [orderId], references: [id])
  seller            Seller?       @relation(fields: [sellerId], references: [id])
  user              User          @relation(fields: [userId], references: [id])
}

model WebhookEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique
  eventType   String
  payload     Json
  processed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  processedAt DateTime?
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  name      String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  country   String   @default("India")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  orders    Order[]

  @@index([userId])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

model Event {
  id        BigInt   @id @default(autoincrement())
  userId    String?
  sessionId String
  eventName String
  productId String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([sessionId, createdAt])
  @@index([eventName, createdAt])
}

model CustomerFlag {
  userId          String
  flag            String
  evidence        Json
  firstDetectedAt DateTime @default(now())
  lastUpdatedAt   DateTime @default(now())
  resolved        Boolean  @default(false)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, flag])
  @@index([flag, resolved])
}

enum ClassificationConfidence {
  HIGH
  LOW
  UNCLASSIFIED
}

enum ClassificationStatus {
  CLASSIFIED
  NEEDS_REVIEW
}

enum Role {
  CUSTOMER
  SELLER
  ADMIN
}

enum SellerAccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum SellerApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESUBMISSION_REQUIRED
}

enum GSTStatus {
  NOT_SUBMITTED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  RESUBMISSION_REQUIRED
}

enum PaymentType {
  SELLER_ONBOARDING
  CUSTOMER_ORDER
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

enum OrderStatus {
  PAYMENT_PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  IN_TRANSIT
  REFUND_INITIATED
  REFUNDED
}

enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  REJECTED
}

enum PriceChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ShippingStatus {
  NOT_CREATED
  CREATED
  AWB_ASSIGNED
  PICKUP_SCHEDULED
  SHIPPED
  IN_TRANSIT
  DELIVERED
  CANCELLED
  EXCEPTION
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CouponStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum LeadSource {
  CANCELLED_ORDER
  INCOMPLETE_CHECKOUT
  ABANDONED_CHECKOUT
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  LOST
}

model Coupon {
  id                String        @id @default(uuid())
  code              String        @unique
  description       String?
  discountType      DiscountType  @default(PERCENTAGE)
  discountValue     Int           // Percentage (e.g. 10 for 10%) or fixed amount in paise (e.g. 5000 for ₹50)
  minOrderAmount    Int           @default(0) // Minimum order subtotal in paise
  maxDiscountAmount Int?          // Max discount in paise (for PERCENTAGE discounts)
  startDate         DateTime      @default(now())
  expiryDate        DateTime?
  maxUsageLimit     Int?          // Total times this coupon can be used across all users (null = unlimited)
  perCustomerLimit  Int           @default(1) // Max times a single customer can use this coupon
  usageCount        Int           @default(0) // Successful redemptions count
  status            CouponStatus  @default(ACTIVE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  orders            Order[]
  usages            CouponUsage[]

  @@index([code, status])
}

model CouponUsage {
  id              String   @id @default(uuid())
  couponId        String
  orderId         String?  @unique
  userId          String?
  customerEmail   String?
  customerPhone   String?
  discountApplied Int      // Discount given in paise
  createdAt       DateTime @default(now())

  coupon          Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order           Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([couponId])
  @@index([userId])
  @@index([customerEmail])
  @@index([customerPhone])
}

// ─── Canonical Store Categories (Closed Taxonomy) ─────────────────────────────

model Category {
  id             String          @id @default(uuid())
  name           String          @unique
  slug           String          @unique
  description    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  products       Product[]
  stagingChanges StagingChange[]

  @@index([slug])
}

// ─── Immutable Supplier Catalog Mirror ──────────────────────────────────────────

model SupplierProduct {
  id                String         @id @default(uuid())
  supplierKey       String         // e.g. "MATIN_IMPEX" | "JINDEAL"
  externalProductId String         // Supplier product ID (e.g. "7717825151030")
  externalVariantId String         @default("") // Never NULL: prevents Postgres NULL bypass in unique index
  sku               String?        // Normalized SKU/model code
  title             String
  variantTitle      String?        // e.g. "Silver / 12PCS"
  handle            String?
  productType       String?
  tags              String[]       @default([])
  costPaise         Int?           // Wholesale cost in integer paise
  available         Boolean        @default(true)
  rawPayload        Json           // Unaltered raw payload from supplier
  contentHash       String         // Hash of current supplier payload
  appliedHash       String?        // Hash of last diffed & applied payload
  consecutiveMisses Int            @default(0) // Tracks runs absent to enforce "discontinued needs 2 misses"
  firstSeenAt       DateTime       @default(now())
  lastSeenAt        DateTime       @default(now())
  lastCrawlRunId    String?
  supplierStatus    SupplierStatus @default(ACTIVE)
  productId         String?        // Optional link to live Product row
  matchMethod       String?        // "SKU" | "MANUAL" | "BACKFILL"
  product           Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  crawlRun          CrawlRun?      @relation(fields: [lastCrawlRunId], references: [id], onDelete: SetNull)

  @@unique([supplierKey, externalProductId, externalVariantId])
  @@index([supplierKey, sku])
  @@index([supplierKey, lastSeenAt])
  @@index([productId])
  @@index([supplierStatus])
}

// ─── Crawl Execution Ledger & Checkpoints ─────────────────────────────────────

model CrawlRun {
  id               String            @id @default(uuid())
  supplierKey      String            // "MATIN_IMPEX" | "JINDEAL"
  targetUrl        String
  mode             CrawlMode         @default(DRY_RUN)
  status           CrawlRunStatus    @default(RUNNING)
  cursor           Json?             // { page: 12, collection: "all" }
  expectedCount    Int?              // Supplier's reported count (e.g. 3039)
  seenCount        Int               @default(0)
  guardrailReport  Json?             // Circuit breaker validation results
  stats            Json?             // { matched: 640, oos: 39, restocked: 19, new: 210 }
  startedAt        DateTime          @default(now())
  heartbeatAt      DateTime          @default(now())
  finishedAt       DateTime?
  appliedAt        DateTime?
  approvedBy       String?
  error            String?
  stagingChanges   StagingChange[]
  supplierProducts SupplierProduct[]
  auditLogs        SyncAuditLog[]

  @@index([supplierKey, status])
  @@index([startedAt])
}

// ─── Dry-Run Diff Engine & Admin Staging Queue ────────────────────────────────

model StagingChange {
  id                       String                   @id @default(uuid())
  runId                    String
  dedupeKey                String                   @unique // "supplierKey:extProd:extVar:type:afterHash"
  changeType               StagingChangeType        // NEW, STOCK_CHANGED, PRICE_CHANGED, DISCONTINUED, REAPPEARED
  supplierKey              String
  externalProductId        String
  externalVariantId        String                   @default("")
  suggestedTitle           String
  categoryId               String?
  category                 Category?                @relation(fields: [categoryId], references: [id])
  classificationConfidence ClassificationConfidence @default(UNCLASSIFIED)
  classificationStatus     ClassificationStatus     @default(NEEDS_REVIEW)
  suggestedPrice           Int                      // Retail price in paise (cost * 1.4)
  originalCost             Int                      // Wholesale cost in paise
  targetProductId          String?                  // Live product ID if updating existing
  before                   Json?                    // Snapshot of live values before change
  after                    Json?                    // Proposed new values
  status                   StagingStatus            @default(PENDING)
  appliedAt                DateTime?
  conflictNote             String?
  createdAt                DateTime                 @default(now())
  crawlRun                 CrawlRun                 @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@index([runId, status])
  @@index([changeType, status])
}

// ─── Transactional Audit Log (Immutable History) ──────────────────────────────

model SyncAuditLog {
  id              String    @id @default(uuid())
  runId           String?
  stagingChangeId String?
  productId       String?   // No FK: audit record deliberately outlives deleted products
  field           String    // "stock" | "supplierAvailable" | "price" | "status"
  oldValue        Json?
  newValue        Json?
  actor           String    @default("SYSTEM_CRAWLER") // "SYSTEM_CRAWLER" | "ADMIN_APPROVAL"
  revertedAt      DateTime?
  createdAt       DateTime  @default(now())
  crawlRun        CrawlRun? @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@unique([stagingChangeId, field])
  @@index([productId, createdAt])
  @@index([runId])
}

// ─── Supporting Enums ─────────────────────────────────────────────────────────

enum SupplierStatus {
  ACTIVE
  OUT_OF_STOCK
  DISCONTINUED
}

enum CrawlMode {
  DRY_RUN
  STOCK_ONLY
  FULL
}

enum CrawlRunStatus {
  RUNNING
  CRAWLED           // Finished crawling, nothing written to live tables
  HALTED_GUARDRAIL  // Circuit breaker tripped, awaiting admin sign-off
  APPLYING
  APPLIED
  FAILED
  ABORTED
  ROLLED_BACK
}

enum StagingChangeType {
  NEW
  STOCK_CHANGED
  PRICE_CHANGED
  DISCONTINUED
  REAPPEARED
}

enum StagingStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
  CONFLICT
  SUPERSEDED
}

// ─── Customer Intelligence Tables ─────────────────────────────────────────────

/// Raw first-party events (all 20 event types from the CI plan).
/// NOTE: Postgres table partitioning is managed via raw SQL migration; Prisma
/// models the logical table without partition syntax.
model CIEvent {
  eventId     String   @id @map("event_id")
  ts          DateTime
  anonymousId String   @map("anonymous_id")
  sessionId   String   @map("session_id")
  customerId  String?  @map("customer_id")
  eventName   String   @map("event_name")
  productId   String?  @map("product_id")
  pagePath    String?  @map("page_path")
  device      String?
  utm         Json?
  props       Json?
  isBot       Boolean  @default(false) @map("is_bot")
  isInternal  Boolean  @default(false) @map("is_internal")
  isSynthetic Boolean  @default(false) @map("is_synthetic")

  @@index([sessionId, ts])
  @@index([eventName, ts])
  @@index([anonymousId, ts])
  @@map("ci_events")
}

/// Anonymous-to-customer identity stitching.
model CIIdentityLink {
  anonymousId String   @map("anonymous_id")
  customerId  String   @map("customer_id")
  linkedAt    DateTime @default(now()) @map("linked_at")

  @@id([anonymousId, customerId])
  @@index([customerId])
  @@map("ci_identity_links")
}

/// One row per visitor session (built by the 15-min sessionizer cron).
model CISession {
  sessionId   String   @id @map("session_id")
  visitorKey  String   @map("visitor_key")
  startedAt   DateTime @map("started_at")
  endedAt     DateTime @map("ended_at")
  source      String?
  device      String?
  pages       Int      @default(0)
  maxStage    String?  @map("max_stage")
  cartValue   Decimal? @map("cart_value") @db.Decimal(12, 2)
  hadError    Boolean  @default(false) @map("had_error")
  isLost      Boolean  @default(false) @map("is_lost")
  isRecovered Boolean? @map("is_recovered")

  diagnosis CISessionDiagnosis?

  @@index([visitorKey, startedAt])
  @@index([isLost, startedAt])
  @@map("ci_sessions")
}

/// Per-visitor rolling 30-day features (rebuilt hourly).
model CICustomerFeature {
  visitorKey        String    @id @map("visitor_key")
  sessions30d       Int       @default(0) @map("sessions_30d")
  productViews30d   Int       @default(0) @map("product_views_30d")
  carts30d          Int       @default(0) @map("carts_30d")
  checkouts30d      Int       @default(0) @map("checkouts_30d")
  ordersTotal       Int       @default(0) @map("orders_total")
  lastOrderAt       DateTime? @map("last_order_at")
  avgOrderValue     Decimal?  @map("avg_order_value") @db.Decimal(12, 2)
  coaClicks30d      Int       @default(0) @map("coa_clicks_30d")
  whatsappClicks30d Int       @default(0) @map("whatsapp_clicks_30d")
  updatedAt         DateTime  @default(now()) @map("updated_at")

  @@map("ci_customer_features")
}

/// Per-product daily demand (rebuilt hourly from events + orders).
model CIProductDaily {
  day              DateTime @db.Date
  productId        String   @map("product_id")
  views            Int      @default(0)
  carts            Int      @default(0)
  purchases        Int      @default(0)
  unitsSold        Int      @default(0) @map("units_sold")
  searches         Int      @default(0)
  noResultSearches Int      @default(0) @map("no_result_searches")
  oosViews         Int      @default(0) @map("oos_views")
  requests         Int      @default(0)
  whatsappClicks   Int      @default(0) @map("whatsapp_clicks")

  @@id([day, productId])
  @@index([productId, day])
  @@map("ci_product_daily")
}

/// One cause per lost session with evidence (hourly diagnosis cron).
model CISessionDiagnosis {
  sessionId   String    @id @map("session_id")
  cause       String
  confidence  String
  evidence    Json
  ruleVersion String    @map("rule_version")
  diagnosedAt DateTime  @default(now()) @map("diagnosed_at")
  handled     Boolean   @default(false)
  handledAt   DateTime? @map("handled_at")
  handledBy   String?   @map("handled_by")

  session CISession @relation(fields: [sessionId], references: [sessionId])

  @@index([cause, diagnosedAt])
  @@index([handled, diagnosedAt])
  @@map("ci_session_diagnosis")
}

/// Recommended actions per visitor, with holdout group.
model CIAction {
  actionId   BigInt    @id @default(autoincrement()) @map("action_id")
  visitorKey String    @map("visitor_key")
  cause      String
  actionType String    @map("action_type")
  inHoldout  Boolean   @default(false) @map("in_holdout")
  status     String    @default("suggested")
  createdAt  DateTime  @default(now()) @map("created_at")
  handledBy  String?   @map("handled_by")
  handledAt  DateTime? @map("handled_at")

  outcome CIOutcome?

  @@index([visitorKey, createdAt])
  @@index([status, createdAt])
  @@map("ci_actions")
}

/// What happened after each action (7-day attribution window).
model CIOutcome {
  actionId    BigInt    @id @map("action_id")
  purchased   Boolean   @default(false)
  orderValue  Decimal?  @map("order_value") @db.Decimal(12, 2)
  grossMargin Decimal?  @map("gross_margin") @db.Decimal(12, 2)
  windowEnd   DateTime? @map("window_end")

  action CIAction @relation(fields: [actionId], references: [actionId])

  @@map("ci_outcomes")
}

/// Supplier reliability per product (refreshed daily).
model CISupplierHealth {
  sellerId        String   @map("seller_id")
  productId       String   @map("product_id")
  avgDispatchDays Decimal  @map("avg_dispatch_days") @db.Decimal(6, 2)
  cancelRate      Decimal  @map("cancel_rate") @db.Decimal(6, 4)
  stockoutDays30d Int      @map("stockout_days_30d")
  isFlagged       Boolean  @default(false) @map("is_flagged")
  hasCoaDoc       Boolean  @default(false) @map("has_coa_doc")
  listingScore    Int      @default(0) @map("listing_score")
  updatedAt       DateTime @default(now()) @map("updated_at")

  @@id([sellerId, productId])
  @@index([isFlagged])
  @@map("ci_supplier_health")
}

// ─── Checkout Growth Models ───────────────────────────────────────────────────

model CheckoutTier {
  id              Int       @id @default(autoincrement())
  campaign        String    @default("default")
  minSubtotal     Decimal   @map("min_subtotal") @db.Decimal(12, 2)
  discountPercent Decimal   @default(0) @map("discount_percent") @db.Decimal(5, 2)
  maxDiscount     Decimal?  @map("max_discount") @db.Decimal(12, 2)
  giftSku         String?   @map("gift_sku")
  active          Boolean   @default(true)
  validFrom       DateTime? @map("valid_from")
  validTo         DateTime? @map("valid_to")

  @@index([campaign, active])
  @@map("checkout_tiers")
}

model CheckoutConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("checkout_config")
}

model EkoraPointsLedger {
  id             BigInt    @id @default(autoincrement())
  userId         String    @map("user_id")
  orderId        String?   @map("order_id")
  type           String
  status         String    @default("pending")
  points         Int
  remaining      Int?
  issuedAt       DateTime? @map("issued_at")
  expiresAt      DateTime? @map("expires_at")
  note           String?
  idempotencyKey String?   @unique @map("idempotency_key")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")

  user           User      @relation(fields: [userId], references: [id])
  order          Order?    @relation(fields: [orderId], references: [id])
  redemptions    EkoraRedemptionAllocation[] @relation("RedeemRow")
  allocations    EkoraRedemptionAllocation[] @relation("EarnRow")

  @@index([userId, expiresAt])
  @@index([userId, createdAt(sort: Desc)])
  @@map("ekora_points_ledger")
}

model EkoraRedemptionAllocation {
  id          BigInt            @id @default(autoincrement())
  redeemRowId BigInt            @map("redeem_row_id")
  earnRowId   BigInt            @map("earn_row_id")
  points      Int

  redeemRow   EkoraPointsLedger @relation("RedeemRow", fields: [redeemRowId], references: [id])
  earnRow     EkoraPointsLedger @relation("EarnRow", fields: [earnRowId], references: [id])

  @@map("ekora_redemption_allocations")
}

model GiftClaim {
  id                 BigInt   @id @default(autoincrement())
  campaign           String
  userId             String?  @map("user_id")
  phoneHash          String?  @map("phone_hash")
  addressHash        String?  @map("address_hash")
  paymentFingerprint String?  @map("payment_fingerprint")
  orderId            String   @map("order_id")
  giftSku            String   @map("gift_sku")
  giftMrp            Decimal  @map("gift_mrp") @db.Decimal(12, 2)
  status             String   @default("claimed")
  claimedAt          DateTime @default(now()) @map("claimed_at")

  order              Order    @relation(fields: [orderId], references: [id])

  @@index([campaign, phoneHash])
  @@index([campaign, addressHash])
  @@index([campaign, paymentFingerprint])
  @@map("gift_claims")
}

model OrderAdjustment {
  id         BigInt   @id @default(autoincrement())
  orderId    String   @map("order_id")
  kind       String
  tierId     Int?     @map("tier_id")
  amount     Decimal  @default(0) @db.Decimal(12, 2)
  giftSku    String?  @map("gift_sku")
  pointsUsed Int?     @map("points_used")
  createdAt  DateTime @default(now()) @map("created_at")

  order      Order    @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("order_adjustments")
}

model RecRule {
  id           BigInt   @id @default(autoincrement())
  modelVersion String   @map("model_version")
  antecedent   String[]
  consequent   String
  support      Decimal  @db.Decimal(8, 6)
  confidence   Decimal  @db.Decimal(8, 6)
  lift         Decimal  @db.Decimal(10, 4)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([modelVersion])
  @@map("rec_rules")
}

model RecModelState {
  id            Int      @id @default(1)
  activeVersion String   @map("active_version")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("rec_model_state")
}

model CheckoutEvent {
  id        BigInt   @id @default(autoincrement())
  sessionId String?  @map("session_id")
  userId    String?  @map("user_id")
  cartId    String?  @map("cart_id")
  orderId   String?  @map("order_id")
  variant   String?
  event     String
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([event, createdAt])
  @@index([sessionId, createdAt])
  @@map("checkout_events")
}

// ─── Product Reviews & Verified Purchase Invites ──────────────────────────────

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model ReviewToken {
  id          String    @id @default(uuid())
  token       String    @unique
  orderId     String
  orderItemId String    @unique
  productId   String
  createdById String?
  expiresAt   DateTime?
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  review      Review?

  @@index([orderId, productId])
  @@index([productId])
}

model Review {
  id                 String       @id @default(uuid())
  productId          String
  userId             String?
  orderId            String?
  orderItemId        String?      @unique
  reviewTokenId      String?      @unique
  rating             Int
  title              String?
  comment            String
  reviewerName       String?
  reviewerEmail      String?
  isVerifiedPurchase Boolean      @default(false)
  status             ReviewStatus @default(PENDING)
  moderatedById      String?
  moderatedAt        DateTime?
  moderationNote     String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User?        @relation("CustomerReviews", fields: [userId], references: [id], onDelete: SetNull)
  order              Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItem          OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  reviewToken        ReviewToken? @relation(fields: [reviewTokenId], references: [id], onDelete: SetNull)
  moderatedBy        User?        @relation("AdminModeratedReviews", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@index([productId, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([rating])
  @@index([userId, productId])
  @@index([orderId, productId])
  @@index([reviewerEmail, productId])
}
