generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String?
  role          Role           @default(CUSTOMER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  name          String?
  phone         String?        @unique
  businessName  String?
  googleId      String?        @unique
  addresses     Address[]
  cart          Cart?
  customerFlags CustomerFlag[]
  events        Event[]
  orders        Order[]
  payments      Payment[]
  adminProducts Product[]      @relation("AdminCreatedProducts")
  seller        Seller?
}

model Seller {
  id                  String                  @id
  userId              String                  @unique
  brandName           String
  accountStatus       SellerAccountStatus     @default(DISABLED)
  applicationStatus   SellerApplicationStatus @default(DRAFT)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  rejectionReason     String?
  payments            Payment[]
  priceChangeRequests PriceChangeRequest[]
  products            Product[]               @relation("SellerProducts")
  user                User                    @relation(fields: [userId], references: [id])
  businessDetails     SellerBusiness?
}

model SellerBusiness {
  id                     String    @id @default(uuid())
  sellerId               String    @unique
  legalName              String
  businessType           String
  address                String
  gstin                  String?
  gstStatus              GSTStatus @default(NOT_SUBMITTED)
  documentUrls           Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  addressType            String?
  city                   String?
  constitutionOfBusiness String?
  country                String?   @default("India")
  district               String?
  gstRegistrationDate    String?
  natureOfBusiness       Json?
  pincode                String?
  state                  String?
  taxpayerType           String?
  tradeName              String?
  seller                 Seller    @relation(fields: [sellerId], references: [id])
}

model Product {
  id                       String                   @id @default(uuid())
  title                    String
  description              String?
  price                    Int
  stock                    Int                      @default(0)
  status                   ProductStatus            @default(DRAFT)
  rejectionReason          String?
  imageUrl                 String?
  sellerId                 String?
  createdByAdminId         String?
  source                   String                   @default("SELLER")
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  customerPrice            Int?
  category                 String?                  @default("General Silicone Moulds")
  classificationConfidence ClassificationConfidence @default(UNCLASSIFIED)
  classificationStatus     ClassificationStatus     @default(NEEDS_REVIEW)
  moq                      Int                      @default(1)
  wholesaleTiers           Json?
  breadthCm                Float?
  heightCm                 Float?
  lengthCm                 Float?
  weightKg                 Float?
  cartItems                CartItem[]
  priceChangeRequests      PriceChangeRequest[]
  adminCreator             User?                    @relation("AdminCreatedProducts", fields: [createdByAdminId], references: [id])
  seller                   Seller?                  @relation("SellerProducts", fields: [sellerId], references: [id])

  @@index([status, category])
  @@index([status, sellerId])
}

model PriceChangeRequest {
  id             String                   @id @default(uuid())
  productId      String
  sellerId       String
  oldPrice       Int
  requestedPrice Int
  reason         String?
  status         PriceChangeRequestStatus @default(PENDING)
  adminComment   String?
  createdAt      DateTime                 @default(now())
  reviewedAt     DateTime?
  reviewedBy     String?
  product        Product                  @relation(fields: [productId], references: [id])
  seller         Seller                   @relation(fields: [sellerId], references: [id])
}

model Order {
  id                String               @id @default(uuid())
  customerId        String
  status            OrderStatus          @default(PAYMENT_PENDING)
  paymentStatus     PaymentStatus        @default(PENDING)
  subtotal          Int
  tax               Int                  @default(0)
  shipping          Int                  @default(0)
  total             Int
  currency          String               @default("INR")
  razorpayOrderId   String?              @unique
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  addressId         String?
  addressSnapshot   Json?
  awbCode           String?
  courierName       String?
  deliveredAt       DateTime?
  shipmentId        String?
  shippedAt         DateTime?
  shippingStatus    ShippingStatus       @default(NOT_CREATED)
  shiprocketOrderId String?
  trackingUrl       String?
  dispatchedAt      DateTime?
  address           Address?             @relation(fields: [addressId], references: [id])
  customer          User                 @relation(fields: [customerId], references: [id])
  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  payments          Payment[]
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  notes     String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id                  String   @id @default(uuid())
  orderId             String
  productId           String
  sellerId            String?
  productNameSnapshot String
  priceSnapshot       Int
  quantity            Int
  subtotal            Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  order               Order    @relation(fields: [orderId], references: [id])
}

model Payment {
  id                String        @id @default(uuid())
  userId            String
  sellerId          String?
  orderId           String?
  type              PaymentType
  provider          String        @default("RAZORPAY")
  amount            Int
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  webhookEventId    String?       @unique
  failureReason     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order?        @relation(fields: [orderId], references: [id])
  seller            Seller?       @relation(fields: [sellerId], references: [id])
  user              User          @relation(fields: [userId], references: [id])
}

model WebhookEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique
  eventType   String
  payload     Json
  processed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  processedAt DateTime?
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  name      String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  country   String   @default("India")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  orders    Order[]

  @@index([userId])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

model Event {
  id        BigInt   @id @default(autoincrement())
  userId    String?
  sessionId String
  eventName String
  productId String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([sessionId, createdAt])
  @@index([eventName, createdAt])
}

model CustomerFlag {
  userId          String
  flag            String
  evidence        Json
  firstDetectedAt DateTime @default(now())
  lastUpdatedAt   DateTime @default(now())
  resolved        Boolean  @default(false)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, flag])
  @@index([flag, resolved])
}

enum ClassificationConfidence {
  HIGH
  LOW
  UNCLASSIFIED
}

enum ClassificationStatus {
  CLASSIFIED
  NEEDS_REVIEW
}

enum Role {
  CUSTOMER
  SELLER
  ADMIN
}

enum SellerAccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum SellerApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESUBMISSION_REQUIRED
}

enum GSTStatus {
  NOT_SUBMITTED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  RESUBMISSION_REQUIRED
}

enum PaymentType {
  SELLER_ONBOARDING
  CUSTOMER_ORDER
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

enum OrderStatus {
  PAYMENT_PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  IN_TRANSIT
  REFUND_INITIATED
  REFUNDED
}

enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  REJECTED
}

enum PriceChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ShippingStatus {
  NOT_CREATED
  CREATED
  AWB_ASSIGNED
  PICKUP_SCHEDULED
  SHIPPED
  IN_TRANSIT
  DELIVERED
  CANCELLED
  EXCEPTION
}
